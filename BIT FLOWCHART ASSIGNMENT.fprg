<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="BIT FLOWCHART ASSIGNMENT"/>
        <attribute name="authors" value="HP"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-03 10:15:02 AM"/>
        <attribute name="created" value="SFA7REVTS1RPUC0xU0ZFNE1EOzIwMjYtMTEtMDM7MDM6NTI6MzQgQU07MjQ2NA=="/>
        <attribute name="edited" value="SFA7REVTS1RPUC0xU0ZFNE1EOzIwMjYtMTEtMDM7MTA6MTU6MDIgQU07MjsyNTY1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;welcome to Yovonie Okada park&quot;" newline="True"/>
            <output expression="&quot;You can request now for a safe ride&quot;" newline="True"/>
            <declare name="destination, OkadaReady, more" type="String" array="False" size=""/>
            <declare name="passengers, queueNumber" type="Integer" array="False" size=""/>
            <assign variable="queueNumber" expression="0"/>
            <assign variable="more" expression="&quot;Yes&quot;"/>
            <output expression="&quot;Enter destination&quot;" newline="True"/>
            <input variable="destination"/>
            <output expression="&quot;Enter number of passengers&quot;" newline="True"/>
            <input variable="passengers"/>
            <while expression="passengers &lt;= 0 or destination == &quot;&quot;">
                <output expression="&quot;please correct the request&quot;" newline="True"/>
                <input variable="destination"/>
                <input variable="passengers"/>
            </while>
            <assign variable="queueNumber" expression="QueueNumber + 1"/>
            <output expression="&quot;Is an okada ready? (Yes/No)&quot;" newline="True"/>
            <input variable="OkadaReady"/>
            <if expression="OkadaReady == &quot;Yes&quot; and passengers &lt;= 4">
                <then>
                    <output expression="&quot;Assigned queue&quot; &amp; queueNumber" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Kept in queue&quot; &amp; queueNumber" newline="True"/>
                </else>
            </if>
            <output expression="&quot;Last queue number :&quot; &amp; queueNumber" newline="True"/>
            <output expression="&quot;We wish you a safe ride&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
